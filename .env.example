# ==========================================
# TelePrice Configuration (.env)
# ==========================================

# 1. Telegram Client Credentials (Userbot Scraper via Telethon)
# Obtain from: https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# 2. Telegram Bot Token (Search Bot via python-telegram-bot)
# Obtain from: https://t.me/BotFather -> /newbot
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz123456

# 3. Target Channels to Scrape (Comma-separated channel usernames or IDs)
TARGET_CHANNELS=@digitalpremium_id,@sellerapp_indo,@tokomurahdigital,@akunpremium_store

# 4. Storage & Logging
DB_PATH=database.sqlite3
SESSION_NAME=teleprice_userbot
LOG_LEVEL=INFO
